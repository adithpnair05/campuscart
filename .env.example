# Copy this file to .env and change SECRET_KEY before any shared deployment.
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///campuscart.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=15728640
# DEMO is usable locally without gateway credentials. Set RAZORPAY for real test/live checkout.
PAYMENT_MODE=DEMO
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CAMPUSCART_ADMIN_EMAIL=admin@campuscart.local
CAMPUSCART_ADMIN_PASSWORD=Admin@12345
